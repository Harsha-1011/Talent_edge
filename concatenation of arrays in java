import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        int[] ans = new int[2*n];
        for(int i = 0;i < n;i++){
            arr[i] = sc.nextInt();
        }
        for(int i = 0;i < n;i++){
            ans[i] = arr[i];
            ans[n + i] = arr[i];
        }
        for(int i = 0;i < 2*n;i++){
            System.out.print(ans[i] + " ");
        }
        sc.close();
    }
} 
