import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc = new Scanner(System.in);
        HashSet<Integer>Harsha = new HashSet<>();
        int n = sc.nextInt();
        int[] nums = new int[n];
        for(int i = 0;i < n;i++){
            nums[i] = sc.nextInt();
        }
        boolean result = false;
        for(int i = 0;i < nums.length;i++){
            if(Harsha.contains(nums[i])){
               result = true;
                break;
            }
            Harsha.add(nums[i]);
        }

    System.out.println(result);
    }
}
